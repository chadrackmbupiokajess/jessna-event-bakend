# Copier ce fichier en .env puis adapter les valeurs (facultatif en développement).
DJANGO_SECRET_KEY=change-moi-avec-une-longue-chaine-aleatoire
DJANGO_DEBUG=1
# Vide en développement = toutes les adresses (accès depuis une autre machine du réseau).
# En production : DJANGO_ALLOWED_HOSTS=jessna-event.com,www.jessna-event.com
DJANGO_ALLOWED_HOSTS=

# Adresse publique du site, utilisée dans les QR codes.
# Vide = automatique (l'adresse utilisée pour ouvrir le site, ex. http://192.168.1.20:3000).
# En production : FRONTEND_URL=https://jessna-event.com
FRONTEND_URL=

# Laisser vide pour SQLite en local. En production :
# DATABASE_URL=postgres://utilisateur:motdepasse@localhost:5432/jessna_event
DATABASE_URL=
